{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/dispatch",
      "destination": "/api/dispatch"
    },
    {
      "source": "/api/twiml",
      "destination": "/api/twiml"
    },
    {
      "source": "/api/:path*",
      "destination": "https://drishti-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
